# Copy to client/.env. These values are PUBLIC (bundled into the browser build).
# Never put the service role key, database URL or payment secret keys here.

# Sign-in goes through the API (Supabase Auth is called server-side), so no
# Supabase keys are needed here.

# Where the Express API lives. Leave empty to use /api on the same origin
# (the Vite dev proxy, or SERVE_CLIENT=true in production).
# Example for a separately hosted API: https://api.yourstore.com/api
# On a different site than the storefront, also set AUTH_COOKIE_SAME_SITE=none on the server.
VITE_API_URL=

# Dev only: where the Vite proxy forwards /api and /uploads
VITE_DEV_API_PROXY=http://localhost:5000
